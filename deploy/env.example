# aac-broker environment — install as /etc/aac-broker/env, mode 0600, owner root.
# Values below are examples; PUSHOVER_* must be filled in for the doorbell to work.

# Where identity, paired connections, grants and the audit log live.
AAC_BROKER_STATE_DIR=/var/lib/aac-broker

# Approval page listener. Keep it on loopback and publish it with `tailscale serve`;
# binding it to 0.0.0.0 puts an approval surface on the LAN.
AAC_BROKER_LISTEN=127.0.0.1:8787

# REQUIRED. Tailnet login allowed to approve. Authentication is the
# Tailscale-User-Login header injected by `tailscale serve` (clients cannot
# spoof it, and tagged devices get none), so this must be your own login.
AAC_BROKER_OWNER=you@example.com

# Break-glass only: 1 turns the bearer token back on, for an auth outage.
AAC_BROKER_ALLOW_TOKEN=0
# Generate with: openssl rand -hex 24
AAC_BROKER_TOKEN=

# Public host used for the same-origin check on POSTs, and the link in notifications.
AAC_BROKER_HOST=aac-broker.example.com
AAC_BROKER_PUBLIC_URL=https://aac-broker.example.com/

# Confine domain lookup to one Bitwarden collection. Unset = whole vault (warned at start).
# AAC_BROKER_COLLECTION_ID=

# How long a request may wait for a decision before it is denied.
# Approval window, and the client must wait longer than this (aac-cred: 330s).
AAC_BROKER_TIMEOUT=300
# OFF by default. When 1, a successful page unlock writes the session key to
# $STATE_DIR/bw-session.json (0600) with an ABSOLUTE expiry, so restarts reuse
# the window you granted instead of asking for the password again. A restart can
# never extend it. The cost is real: the file is the vault key at rest, so root
# on this host could read the vault without your password.
AAC_BROKER_PERSIST_SESSION=0

# Doorbell. Optional: without these the broker runs with no notifications.
PUSHOVER_TOKEN=
PUSHOVER_USER=
# A light sound and normal priority by default; priority 1 bypasses quiet hours.
PUSHOVER_SOUND=bike
PUSHOVER_PRIORITY=0

RUST_LOG=info

# Bitwarden CLI config path — MEASURED, and not what the variable name suggests.
# `bw` ignores BW_CONFIG_DIR and resolves to $HOME/.config/Bitwarden CLI, so the working
# arrangement is that symlink pointing at the state dir:
#   install -d -o <user> -g <user> -m 0700 /var/lib/aac-broker/.config
#   ln -sfn /var/lib/aac-broker/bw "<home>/.config/Bitwarden CLI"
# Get this wrong and `bw status` reports unauthenticated in a fresh dir, so every unlock
# fails with a confusing error even though the vault login is intact.
HOME=<home-of-the-service-user>
BW_CONFIG_DIR=/var/lib/aac-broker/bw
